; Engine configuration file.
; Pinned engine: Godot 4.7.2-stable (see BUILDING.md).

config_version=5

[application]

config/quit_on_go_back=false

config/name="Legend Arrow"
config/description="A calm arrow puzzle game. Clear the arrows, awaken legendary creatures."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/icon/icon_192.png"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.98039216, 0.9764706, 0.9647059, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/app/game.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray()

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://locales/strings.en.translation", "res://locales/strings.es.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.98039216, 0.9764706, 0.9647059, 1)
